<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="true"
    android:scrollbarThumbVertical="@color/minebutton_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_heavy"
        android:paddingTop="@dimen/padding_heavy"
        android:paddingBottom="@dimen/padding_large">

        <!-- Version filter -->
        <TextView
            android:id="@+id/search_mod_mc_version_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profiles_profile_version"
            android:textColor="@color/primary_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/search_mod_selected_mc_version_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/background_line"
                android:hint="@string/version_select_hint"
                android:paddingHorizontal="@dimen/padding_heavy"
                android:textSize="@dimen/_13ssp" />

            <Button
                android:id="@+id/search_mod_mc_version_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_medium"
                android:paddingHorizontal="@dimen/padding_large"
                android:text="@string/global_select" />
        </LinearLayout>

        <!-- Loader filter -->
        <TextView
            android:id="@+id/search_mod_loader_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/content_filter_loader"
            android:textColor="@color/primary_text" />

        <Spinner
            android:id="@+id/search_mod_loader_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:background="@drawable/background_line"
            android:dropDownWidth="match_parent"
            android:paddingVertical="0px" />

        <!-- Sort filter -->
        <TextView
            android:id="@+id/search_mod_sort_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/content_filter_sort"
            android:textColor="@color/primary_text" />

        <Spinner
            android:id="@+id/search_mod_sort_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:background="@drawable/background_line"
            android:dropDownWidth="match_parent"
            android:paddingVertical="0px" />

        <!-- Category filter -->
        <TextView
            android:id="@+id/search_mod_categories_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_medium"
            android:text="@string/content_filter_categories"
            android:textColor="@color/primary_text" />

        <Button
            android:id="@+id/search_mod_categories_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_tiny"
            android:background="@drawable/background_line"
            android:gravity="start"
            android:paddingHorizontal="@dimen/padding_heavy"
            android:text="@string/content_filter_any"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp" />

        <!-- Apply -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/search_mod_apply_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_large"
            android:text="@string/generic_apply" />

    </LinearLayout>
</ScrollView>
