<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_app"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_34sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_medium">

    <TextView
        android:id="@+id/version_entry_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/version_entry_compat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_small"
        android:background="@drawable/badge_compat_fit"
        android:paddingHorizontal="@dimen/padding_small"
        android:paddingVertical="@dimen/padding_tiny"
        android:text="@string/content_compat_badge_fit"
        android:textColor="@color/compat_green"
        android:textSize="@dimen/_10ssp"
        android:visibility="gone" />

</LinearLayout>
