<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/padding_large">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dependency_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/dependency_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_24sdp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/dependency_site_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_small"
        android:text="@string/content_open_site"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_11ssp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/dependency_tick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
