<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginHorizontal="@dimen/padding_medium"
    android:layout_marginVertical="@dimen/padding_small"
    android:paddingHorizontal="@dimen/padding_medium"
    android:paddingVertical="@dimen/padding_small">

    <CheckBox
        android:id="@+id/dependency_tick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/minebutton_color" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_small"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dependency_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dependency_needed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_small"
                android:background="@drawable/badge_dependency_needed"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingVertical="@dimen/padding_tiny"
                android:text="@string/content_dependencies_needed_badge"
                android:textColor="@color/minebutton_color"
                android:textSize="@dimen/_10ssp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/dependency_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_small"
            android:background="@drawable/spinner_background"
            android:minHeight="@dimen/_28sdp"
            android:paddingHorizontal="@dimen/padding_small"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/dependency_site_button"
        style="@style/MojoLauncher.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_small"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="@dimen/padding_medium"
        android:text="@string/content_open_site"
        android:textColor="@color/minebutton_color"
        android:textSize="@dimen/_12ssp"
        android:visibility="gone" />

</LinearLayout>
