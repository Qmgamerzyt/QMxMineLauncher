<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/padding_small">

    <ImageView
        android:id="@+id/content_thumb"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/content_thumb_background"
        android:contentDescription="@null"
        android:padding="@dimen/padding_small"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_px_file" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_medium"
        android:layout_weight="1"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/content_toggle_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp" />

        <TextView
            android:id="@+id/content_toggle_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding_medium"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/content_toggle_remove"
        style="@style/MojoLauncher.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_small"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="@dimen/padding_medium"
        android:text="@string/content_manage_remove"
        android:textColor="@color/minebutton_color"
        android:textSize="@dimen/_12ssp" />

</LinearLayout>
